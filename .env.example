# Copy to .env and fill in. agent.py loads this file.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# OpenAI open-weight comparison on Bedrock: BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
# Alternatively leave the token empty and use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or AWS_PROFILE.
LLM_PROVIDER=bedrock
# Optional OpenAI comparison: set LLM_PROVIDER=openai (or use eval_routing.py --provider openai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI models billed through OpenRouter: set LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
